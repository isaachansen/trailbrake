# Supply-chain hardening (Shai-Hulud-class npm worm defenses).
#
# ignore-scripts: install lifecycle scripts (preinstall/install/postinstall)
#   NEVER run — that's the infection vector these worms use. Our tree doesn't
#   need them: vite/esbuild/rollup/@tauri-apps/cli all ship platform binaries
#   as optionalDependencies, and playwright-core downloads nothing.
#   (`npm run <script>` still works; only install hooks and run pre/post
#   hooks are suppressed.)
#
# save-exact: always pin exact versions — nothing floats to a fresh (possibly
#   compromised) release via a range.
#
# Adding/updating packages: use `npm run add -- <pkg>[@version] [--dev]`,
# which enforces a 14-day publish-age cooldown (scripts/safe-add.mjs).
# Audit the whole lockfile any time with `npm run check-deps` — CI does this
# on every change to package.json/package-lock.json.
ignore-scripts=true
save-exact=true
fund=false
